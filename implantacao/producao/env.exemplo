# /opt/crypto/.env, criado pelo preparar.sh (modo 600): o que o compose.yml interpola.
# Copia no gerenciador de senhas; nunca no Git nem no cofre.
PASTA=/opt/crypto
# Versao da imagem ghcr.io/phkolbe/crypto (tag do repositorio).
VERSAO_CRYPTO=v0.2.0
# No Tailscale `crypto`: https://crypto.<tailnet>.ts.net. A chave de autenticacao
# (Tailscale > Settings > Keys) so na primeira subida; depois, apagar daqui e desligar
# a expiracao da chave do no no painel do Tailscale.
TS_HOSTNAME=crypto
TAILNET=<rede>.ts.net
TS_AUTHKEY=
# O unico login Tailscale (e-mail) que abre a API e as telas; os outros recebem 403.
CRYPTO_LOGIN=<seu e-mail no Tailscale>
# Telemetria (OTLP/HTTP) para a observabilidade, onde ela estiver; vazio, nao sai.
OTEL_ENDPOINT=
# Banco (geradas pelo preparar.sh).
SENHA_DB_POSTGRES=<gerado>
SENHA_DB_CRYPTO_DONO=<gerado>
SENHA_DB_CRYPTO=<gerado>
# Backup (backup.sh): dumps locais em /opt/crypto/backups (0600, pasta 0700) e a copia
# cifrada FORA do servidor com restic -- OBRIGATORIA antes do live (os dumps locais morrem
# com a VM). Repositorio proprio do Crypto; credenciais do provedor em
# /opt/crypto/backup.env (modo 600, criado pelo preparar.sh), ex. AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY ou B2_*. A senha e gerada pelo preparar.sh: guardar uma copia no
# gerenciador de senhas (sem ela o repositorio nao abre depois de perder a VM). Vazio, o
# backup roda so local e avisa no journal toda noite.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=<gerado>
# Vigia externo (vigia.sh, timer systemd crypto-vigia): URL de "estou vivo" de um
# dead-man's switch (ex.: https://hc-ping.com/<uuid> do healthchecks.io). O vigia a
# pinga a cada minuto enquanto o crypto-prd esta healthy e pinga <url>/fail quando
# nao esta; se o ping parar (host fora, timer parado, conteiner que nao volta), o
# servico avisa. Tambem recebe o <url>/fail do backup que falha (avisar-falha.sh).
# Vazio: o vigia so reinicia e a falha do backup so vai para o journal. E segredo.
VIGIA_URL=
