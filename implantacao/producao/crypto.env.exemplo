# Sistema Cripto em producao: /opt/crypto/crypto.env, criado pelo preparar.sh (modo 600).
# Copia no gerenciador de senhas; nunca no Git nem no cofre. So o que e secreto ou e
# trava: banco, telemetria e API vem do compose.yml e vencem este arquivo.
#
# Configuracao de NEGOCIO (pares, limites de risco, estrategias) NAO entra aqui: mora no
# banco e se edita nas telas Configuracoes e Risco. Uma chave de negocio aqui faz o
# sistema recusar subir, listando as chaves (README, "Ambiente e negocio") -- inclusive
# na forma aninhada (TRADING__TIMEFRAME, RISK__MAX_ORDER_NOTIONAL, TRADING={...}), que o
# banco sobrescreveria em silencio na subida.

# --- Modo de operacao -----------------------------------------------------------------
# Producao opera com dinheiro real (decisao de 24/10/2026), mas NASCE em dry_run: o banco
# de producao comeca vazio (o historico do dry_run do notebook nao vem -- trades e
# snapshots simulados dariam preco medio ao stop e base ao circuit breaker com numeros
# falsos), e a configuracao de negocio vale os padroes ate alguem mudar. Ordem:
#   1. subir assim (dry_run) e, em https://crypto.<tailnet>.ts.net/crypto-traders/, configurar
#      Configuracoes e Risco: moeda USDC, pares, limites, CAPITAL AUTORIZADO, notificacoes;
#   2. preencher as chaves abaixo e trocar para TRADING_MODE=live + LIVE_TRADING_CONFIRMED=true;
#   3. implantacao/producao/implantar.sh  (recria o conteiner com o arquivo novo).
# As duas travas sao de proposito: dinheiro real e editar ESTE arquivo no servidor e
# reiniciar. Em live sem as chaves o sistema RECUSA subir (nao cai para simulacao).
TRADING_MODE=dry_run
LIVE_TRADING_CONFIRMED=false

# --- Binance --------------------------------------------------------------------------
# Chave PROPRIA de producao (nao a do notebook): leitura + negociacao, NUNCA saque, e
# whitelist de IP com o IP PUBLICO de saida do servidor (`curl -s https://api.ipify.org`).
BINANCE__API_KEY=
BINANCE__API_SECRET=
EXCHANGE=binance

# --- Alertas de negocio do proprio Crypto (stop executado, circuit breaker...) --------
# Liga/desliga e destinatarios ficam na tela Notificacoes; aqui so os segredos.
# O certificado do servidor SMTP e verificado (STARTTLS na 587; na 465, TLS implicito).
# Canal ligado na tela sem estes segredos: cada alerta deixa um erro
# `notification.sem_entrega` no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Destinatarios de RESERVA: so quando o banco nao responde E o sistema ainda nao leu a tela
# Notificacoes desde que subiu (subiu com o Postgres fora). Com o banco no ar vale a tela;
# com ele fora depois de uma leitura, vale a ultima configuracao lida. Recomendado: os
# mesmos destinatarios da tela, para o alerta "sem acesso ao banco" sair sempre.
ALERTA_EMAIL_RESERVA=
ALERTA_WHATSAPP_RESERVA=

LOG_LEVEL=INFO
