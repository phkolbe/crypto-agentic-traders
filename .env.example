# =============================================================================
# crypto-agentic-traders — configuracao de AMBIENTE
#
# Copie para `.env` e ajuste. O `.env` esta no .gitignore e NUNCA deve ser
# versionado, colado em chat ou enviado por e-mail.
#
# -----------------------------------------------------------------------------
# ESTE ARQUIVO CONTEM APENAS CONFIGURACAO DE AMBIENTE.
#
# Ambiente = o que descreve esta INSTALACAO: credenciais, banco, event bus,
# host da API, canais de alerta, e as travas de seguranca que precisam estar
# fora do alcance do navegador.
#
# Negocio = o que responde "o que eu quero negociar e com quanto risco": pares,
# timeframe, estrategias, cadencia de coleta, limites de risco, filtro MVRV,
# parametros de simulacao. Tudo isso mora no BANCO e e editado em
# **Configuracoes** e **Risco**, na interface web.
#
# Escrever uma variavel de negocio aqui faz o sistema RECUSAR SUBIR, listando
# as chaves. Isso e proposital: um valor que parece ter efeito e nao tem e pior
# que valor nenhum -- foi assim que este `.env` pediu ordem maxima de 7 USDT
# durante dias enquanto o sistema operava com 50.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO DE OPERACAO  (a configuracao mais importante deste arquivo)
#
# E AMBIENTE, e nao negocio, por decisao explicita: ligar dinheiro real deve
# exigir editar um arquivo no servidor e reiniciar o processo. Se morasse no
# banco, um clique na interface poderia ligar ordens reais.
# -----------------------------------------------------------------------------
# dry_run  -> nenhuma ordem sai da maquina (PADRAO, use este por semanas)
# testnet  -> ordens reais contra a testnet da exchange, dinheiro ficticio
# live     -> ORDENS REAIS COM DINHEIRO REAL
TRADING_MODE=dry_run

# Segunda tranca: `TRADING_MODE=live` sozinho NAO basta, o sistema recusa subir.
# Ligar isto e uma decisao consciente, nunca um typo.
LIVE_TRADING_CONFIRMED=false

# -----------------------------------------------------------------------------
# CREDENCIAIS DAS EXCHANGES
#
# REGRAS AO CRIAR AS CHAVES NA EXCHANGE:
#   1. Permissao de LEITURA + NEGOCIACAO apenas. NUNCA habilite SAQUE/WITHDRAW.
#   2. Habilite whitelist de IP, restrita ao IP desta maquina.
#   3. Rotacione as chaves periodicamente.
# Deixe em branco para operar em dry_run (dados de mercado sao publicos).
# -----------------------------------------------------------------------------
BINANCE__API_KEY=
BINANCE__API_SECRET=

# -----------------------------------------------------------------------------
# EXCHANGE
#
# E ambiente porque esta amarrada a qual credencial existe acima: apontar para
# uma exchange sem chave configurada e erro de instalacao, nao decisao de
# negocio. A MOEDA DE COTACAO (USDC, USDT, BRL) e negocio e fica na interface.
# -----------------------------------------------------------------------------
EXCHANGE=binance

# -----------------------------------------------------------------------------
# PERSISTENCIA
#
# Vazio => SQLite local em ./data (fora do Docker).
# No Docker (docker-compose.yml) o banco e o Postgres do compose, e DATABASE_URL e
# DB_MIGRAR_NA_SUBIDA=false vem de la e vencem este arquivo: o schema e do
# `crypto-traders migrar` (usuario dono), e o `run` so confere.
# -----------------------------------------------------------------------------
DATABASE_URL=
DB_ECHO=false

# memory => bus in-process (padrao) | redis => Redis Streams (exige compose)
EVENT_BUS=memory
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# API / FRONTEND
#
# NAO troque API_HOST por 0.0.0.0: isso exporia o backend na rede local.
# Para acessar de fora, use uma VPN pessoal (Tailscale) em vez de abrir portas.
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Producao (implantacao/producao/): o unico login Tailscale que passa pela API.
# Vazio desliga a trava -- o caso do desenvolvimento, so em 127.0.0.1.
ACESSO_LOGIN_TAILSCALE=

# -----------------------------------------------------------------------------
# OBSERVABILIDADE
#
# OTEL_EXPORTER_OTLP_ENDPOINT: coletor OpenTelemetry (traces, logs e metricas por
# OTLP/HTTP). Vazio desliga. No Docker vem do compose (http://host.docker.internal:4318).
# ENVIRONMENT vira `deployment.environment` na telemetria (dev, prd).
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
OTEL_EXPORTER_OTLP_ENDPOINT=
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# CANAIS DE ALERTA — apenas os SEGREDOS e endpoints
#
# Liga/desliga e destinatarios (e-mail, numero de WhatsApp) sao negocio e ficam
# na tela de Notificacoes. Senha de SMTP e token da Meta ficam SO aqui: chave em
# banco contraria a premissa de seguranca do projeto, e um backup do banco
# passaria a vazar acesso.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
