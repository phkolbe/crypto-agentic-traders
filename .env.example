# =============================================================================
# crypto-agentic-traders — configuracao
#
# Copie para `.env` e ajuste. O `.env` esta no .gitignore e NUNCA deve ser
# versionado, colado em chat ou enviado por e-mail.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO DE OPERACAO  (a configuracao mais importante deste arquivo)
# -----------------------------------------------------------------------------
# dry_run  -> nenhuma ordem sai da maquina (PADRAO, use este por semanas)
# testnet  -> ordens reais contra a testnet da exchange, dinheiro ficticio
# live     -> ORDENS REAIS COM DINHEIRO REAL
TRADING_MODE=dry_run

# Segunda tranca: `TRADING_MODE=live` sozinho NAO basta, o sistema recusa subir.
# Ligar isto e uma decisao consciente, nunca um typo.
LIVE_TRADING_CONFIRMED=false

# -----------------------------------------------------------------------------
# CREDENCIAIS DA BINANCE
#
# Nesta fase o sistema opera SOMENTE na Binance. A Coinbase esta na fase 5 do
# roadmap -- o adapter ccxt ja e generico, entao adiciona-la depois nao mexe em
# codigo de agente.
#
# REGRAS AO CRIAR A CHAVE:
#   1. Permissao de LEITURA + NEGOCIACAO apenas. NUNCA habilite SAQUE/WITHDRAW.
#   2. Habilite whitelist de IP, restrita ao IP desta maquina.
#      ATENCAO: IP residencial e dinamico e muda sozinho. Quando isso acontece,
#      os dados de mercado continuam chegando (sao publicos) mas nenhuma ordem
#      sai -- inclusive as de fechamento. Ver docs/SEGURANCA.md.
#   3. Rotacione a chave periodicamente.
# Deixe em branco para operar em dry_run (dados de mercado sao publicos).
# -----------------------------------------------------------------------------
BINANCE__API_KEY=
BINANCE__API_SECRET=

# -----------------------------------------------------------------------------
# MERCADO
# -----------------------------------------------------------------------------
EXCHANGE=binance
QUOTE_CURRENCY=USDT

# Pares a negociar. Em BRANCO ativa a DESCOBERTA AUTOMATICA ("mar aberto"): o
# sistema varre a exchange e escolhe os pares mais liquidos sozinho, e a lista
# descoberta vira a whitelist efetiva do Risk Manager.
# Leia docs/SEGURANCA.md antes: no modo automatico a whitelist deixa de ser uma
# lista aprovada por voce e passa a ser um conjunto de criterios.
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
CANDLE_HISTORY_LIMIT=500
MARKET_DATA_INTERVAL_SECONDS=60
PORTFOLIO_INTERVAL_SECONDS=60

# Estrategias ativas: ma_crossover, rsi_reversion, macd_trend, bollinger_reversion
STRATEGIES=ma_crossover,rsi_reversion

# -----------------------------------------------------------------------------
# DESCOBERTA AUTOMATICA DE PARES (so vale com SYMBOLS em branco)
# -----------------------------------------------------------------------------
# Piso de liquidez em 24h. Dos 487 pares USDT da Binance, 312 movimentam menos
# de 1M por dia -- nesses, a propria ordem move o preco.
DISCOVERY_MIN_QUOTE_VOLUME_24H=50000000
DISCOVERY_MAX_SYMBOLS=8
DISCOVERY_REFRESH_HOURS=24
# Ativos a excluir alem das stablecoins (ja excluidas por padrao)
DISCOVERY_EXCLUDE_ASSETS=

# -----------------------------------------------------------------------------
# LIMITES DE RISCO  (Risk Manager Agent)
#
# Estes valores tambem podem ser ajustados pela interface web; a partir da
# primeira alteracao, o banco passa a ser a fonte da verdade e toda mudanca
# fica registrada no audit_log.
# -----------------------------------------------------------------------------
RISK_MAX_ORDER_NOTIONAL=50          # valor maximo de UMA ordem, em USDT
RISK_MAX_ORDER_PCT_PORTFOLIO=0.02   # ...e no maximo 2% do portfolio
RISK_MAX_ASSET_EXPOSURE_PCT=0.30    # no maximo 30% do portfolio em um ativo
RISK_MAX_OPEN_POSITIONS=5
RISK_MIN_ORDER_NOTIONAL=10          # abaixo disso a taxa come o resultado
RISK_STOP_LOSS_PCT=0.03
RISK_TAKE_PROFIT_PCT=0.06           # precisa ser > STOP_LOSS_PCT
RISK_DAILY_LOSS_LIMIT_PCT=0.05      # circuit breaker diario
RISK_WEEKLY_LOSS_LIMIT_PCT=0.12     # circuit breaker semanal
RISK_MIN_SIGNAL_CONFIDENCE=0.55
RISK_ASSET_WHITELIST=BTC,ETH,SOL,USDT
RISK_SYMBOL_WHITELIST=BTC/USDT,ETH/USDT,SOL/USDT
RISK_COOLDOWN_SECONDS=900           # intervalo minimo entre ordens do mesmo par

# -----------------------------------------------------------------------------
# PAPER TRADING (usado em dry_run e no backtest)
# -----------------------------------------------------------------------------
PAPER_INITIAL_BALANCE=1000
PAPER_FEE_PCT=0.001
PAPER_SLIPPAGE_PCT=0.0005

# -----------------------------------------------------------------------------
# PERSISTENCIA
#
# Vazio => SQLite local em ./data (nao exige Docker).
# Com o compose no ar, troque para Postgres/TimescaleDB:
#   DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_traders
# -----------------------------------------------------------------------------
DATABASE_URL=
DB_ECHO=false

# memory => bus in-process (padrao) | redis => Redis Streams (exige compose)
EVENT_BUS=memory
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# API / FRONTEND
#
# NAO troque API_HOST por 0.0.0.0: isso exporia o backend na rede local.
# Para acessar de fora, use uma VPN pessoal (Tailscale) em vez de abrir portas.
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# OBSERVABILIDADE E ALERTAS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# Alertas de circuit breaker, perda de acesso a exchange e agente travado.
#
# Aqui ficam apenas os SEGREDOS. Ligar/desligar cada canal e informar o
# destinatario e feito pela tela "Notificacoes" da aplicacao -- credencial em
# banco vazaria acesso em qualquer backup.

# --- E-mail (SMTP). Com Gmail, use uma "senha de app", nao a senha da conta ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# --- WhatsApp (Meta Cloud API) ---
# Alertas sao mensagens proativas e raras, entao nunca ha sessao de 24h aberta:
# o WhatsApp so aceita TEMPLATE aprovado, nunca texto livre. Crie no Meta for
# Developers um template de categoria "utility" com DOIS parametros no corpo:
#     Alerta {{1}}. Detalhe: {{2}}
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
